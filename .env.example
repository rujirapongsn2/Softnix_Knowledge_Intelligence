APP_NAME=Softnix Knowledge Intelligence Platform
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-secret
DATABASE_URL=sqlite:///./data/skip.db
REDIS_URL=redis://redis:6379/0
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-now
FILE_STORAGE_PATH=/data/files
MAX_FILE_SIZE_MB=100
TOKEN_PREFIX=skik_live_
TOKEN_HASH_SECRET=change-me-to-a-different-long-random-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
WEB_PORT=8081
# The chat LLM (answers, planning, metadata extraction, LightRAG graph extraction) is any
# OpenAI-compatible /chat/completions server. Never commit a populated .env file.
# The OPENROUTER_* names of earlier releases are still read when the LLM_* ones are unset.
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=anthropic/claude-sonnet-5.5
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-5-mini
#   vLLM, Ollama, LiteLLM, llama.cpp: LLM_BASE_URL=http://<host>:<port>/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
# A server that needs no key still needs a placeholder here; an empty key turns the LLM off.
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5.5
# How the request spells reasoning effort and the output token limit: openrouter, openai or compatible.
# Empty picks openrouter or openai from LLM_BASE_URL and compatible for any other server.
LLM_API_DIALECT=
# Empty sends no temperature, for models that accept only their default (OpenAI reasoning models).
LLM_TEMPERATURE=0
# Empty sends no reasoning effort. "low" keeps Sonnet from spending the JSON budget on reasoning.
LLM_REASONING_EFFORT=low
# Optional: a cheaper model for LightRAG graph extraction only (defaults to LLM_MODEL).
# LIGHTRAG_LLM_MODEL=openai/gpt-4o-mini

# Embeddings come from any OpenAI-compatible /embeddings server (see deploy/embedding-server/README.md).
# llama-server on this machine:   EMBEDDING_BASE_URL=http://host.docker.internal:8090/v1
# llama-server on another machine: EMBEDDING_BASE_URL=http://<host>:8090/v1
# Leave EMBEDDING_BASE_URL empty to disable vector search. EMBEDDING_API_KEY is sent only when set.
# Changing EMBEDDING_MODEL or EMBEDDING_DIMENSION needs the migration, a Reindex and a LightRAG re-ingest.
EMBEDDING_BASE_URL=http://host.docker.internal:8090/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embeddinggemma-2
EMBEDDING_DIMENSION=768
EMBEDDING_QUERY_PREFIX="task: search result | query: "
EMBEDDING_DOCUMENT_PREFIX="title: none | text: "
# Optional cross-encoder reranking through a Cohere-style POST {base}/rerank (Cohere, Jina, OpenRouter,
# vLLM, llama-server --reranking). RERANK_BASE_URL and RERANK_API_KEY default to the LLM's.
# A local server: deploy/reranker-server/README.md
RERANKER_ENABLED=false
RERANK_MODEL=
RERANK_BASE_URL=
RERANK_API_KEY=
RETRIEVAL_PLANNER_TIMEOUT_SECONDS=4
# Sent as OpenRouter's app attribution headers; LLM_APP_URL is also the fallback public link origin.
LLM_APP_URL=http://localhost:8081
LLM_APP_TITLE=Softnix Knowledge Intelligence Platform

# External OCR v3 — used only when a PDF has no extractable text layer.
# Keep verification false only while the OCR endpoint uses a self-signed/IP certificate.
EXT_OCR_BASE_URL=https://111.223.37.41:9001
EXT_OCR_KEY=
EXT_OCR_VERIFY_SSL=false
EXT_OCR_ENGINE=tesseract
EXT_OCR_IMAGE_SIZE=1800
EXT_OCR_REQUEST_TIMEOUT_SECONDS=60
EXT_OCR_PROCESSING_TIMEOUT_SECONDS=300
EXT_OCR_POLL_INTERVAL_SECONDS=2

LIGHTRAG_BASE_URL=http://lightrag:9621
LIGHTRAG_API_KEY=replace-with-a-different-internal-lightrag-key
LIGHTRAG_IMAGE=ghcr.io/hkuds/lightrag@sha256:de09cd75e32b6b45b104625a9fb229f84f3dec4827ecffc825aa4438b196cbe6
LIGHTRAG_TIMEOUT_SECONDS=120
LIGHTRAG_PROCESSING_TIMEOUT_SECONDS=300
LIGHTRAG_WORKSPACE_PREFIX=skip-
NEO4J_PASSWORD=change-me-now
NEO4J_DATABASE=neo4j
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=120
DEFAULT_TOP_K=12
MAX_GRAPH_DEPTH=3
LOG_QUERY_TEXT=true
# Hot trace/request/MCP retention; compliance audit events use the longer window.
OBSERVABILITY_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=180
# /ready checks these configured services. Leave a URL empty only for local unit tests.

# ---- OCR chain (anydoc pipeline) ----
SOFTNIX_OCR_BASE_URL=https://ocr.example.internal:9001
SOFTNIX_OCR_TOKEN=change-me
SOFTNIX_OCR_INSECURE_TLS=false
SOFTNIX_OCR_TIMEOUT_SECONDS=120
SOFTNIX_OCR_STALL_SECONDS=45
MISTRAL_API_KEY=
OCR_CHAIN_ENGINES=softnix,mistral,tesseract
