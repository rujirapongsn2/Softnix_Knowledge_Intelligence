# Softnix Knowledge Intelligence: settings for an install from Harbor (docker-compose.release.yml).
# deploy/install.sh copies this file to .env and fills every <generated> value with a random secret.
# Never commit a filled .env. See docs/INSTALL_HARBOR.md.

# ---- Release ----------------------------------------------------------------------------------------
# Plain `docker compose ...` (and deploy/check_services.sh, backup.sh, restore.sh) then uses the release file.
COMPOSE_FILE=docker-compose.release.yml
COMPOSE_PROJECT_NAME=ski
SKI_VERSION=v1.0.0
# Where the images come from. An offline install loads them with deploy/offline-bundle.sh and keeps this value.
SKI_REGISTRY=registry.softnix.co.th/ski

# ---- Ports ------------------------------------------------------------------------------------------
# Users open http://<server>:WEB_PORT, normally behind an HTTPS reverse proxy. WEB_BIND=127.0.0.1 keeps it local.
WEB_BIND=0.0.0.0
WEB_PORT=8081
# The api listens on 127.0.0.1 only (health checks, local proxy).
API_PORT=8001
WORKER_REPLICAS=3

# ---- App and secrets (install.sh generates the <generated> values) ----------------------------------
APP_NAME=Softnix Knowledge Intelligence Platform
APP_ENV=production
APP_SECRET_KEY=<generated>
TOKEN_HASH_SECRET=<generated>
TOKEN_PREFIX=skik_live_
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=<generated>
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# true needs HTTPS in front of web. Set false only for a plain-HTTP trial, or the login cookie is dropped.
COOKIE_SECURE=true
# The public address users open; also the origin of shared links.
LLM_APP_URL=https://knowledge.example.com
LLM_APP_TITLE=Softnix Knowledge Intelligence Platform
MAX_FILE_SIZE_MB=100

# Internal service credentials. Postgres and Neo4j read these only when their volume is first created.
POSTGRES_DB=skip
POSTGRES_USER=skip
POSTGRES_PASSWORD=<generated>
NEO4J_PASSWORD=<generated>
NEO4J_DATABASE=neo4j
LIGHTRAG_API_KEY=<generated>
LIGHTRAG_WORKSPACE_PREFIX=skip-
LIGHTRAG_TIMEOUT_SECONDS=120
LIGHTRAG_PROCESSING_TIMEOUT_SECONDS=900

# ---- LLM (any OpenAI-compatible /chat/completions server) -------------------------------------------
# A) On-prem (vLLM, Ollama, LiteLLM, llama.cpp, Typhoon, ...): the default for customer installs.
#      LLM_BASE_URL=http://<llm-host>:<port>/v1   LLM_MODEL=<model name the server lists at /v1/models>
#      LLM_API_DIALECT=compatible   LLM_REASONING_EFFORT=   (empty unless the model accepts reasoning_effort)
#      A server without auth still needs a placeholder key: LLM_API_KEY=none
# B) OpenRouter:
#      LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_API_KEY=sk-or-...   LLM_MODEL=anthropic/claude-sonnet-5.5
#      LLM_API_DIALECT=   (empty picks openrouter)   LLM_REASONING_EFFORT=low
# An empty LLM_API_KEY turns the LLM off. LightRAG uses the same LLM_* values.
LLM_BASE_URL=http://llm.internal:8000/v1
LLM_API_KEY=
LLM_MODEL=
LLM_API_DIALECT=compatible
LLM_TEMPERATURE=0
LLM_REASONING_EFFORT=
# Optional: a separate model for answers, or a cheaper one for LightRAG graph extraction.
# LLM_ANSWER_MODEL=
# LIGHTRAG_LLM_MODEL=
# LIGHTRAG_MAX_ASYNC=4
# Credit warning applies to OpenRouter only.
LLM_CREDIT_WARNING_USD=20

# ---- Embeddings (installed separately, OpenAI-compatible /embeddings) -------------------------------
# e.g. llama-server with embeddinggemma-2 (deploy/embedding-server/README.md). Use the host's address,
# not localhost; host.docker.internal works on Docker Desktop, and on Linux only with an extra_hosts entry.
# Changing the model or dimension after documents are indexed needs a migration and a full reindex.
EMBEDDING_BASE_URL=http://embedding.internal:8090/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embeddinggemma-2
EMBEDDING_DIMENSION=768
EMBEDDING_QUERY_PREFIX="task: search result | query: "
EMBEDDING_DOCUMENT_PREFIX="title: none | text: "

# ---- Reranker (optional, installed separately) ------------------------------------------------------
# cohere style: llama-server --reranking, vLLM, Jina, Cohere. tei: Hugging Face text-embeddings-inference.
RERANKER_ENABLED=false
RERANK_BASE_URL=
RERANK_MODEL=bge-reranker-v2-m3
RERANK_API_KEY=
RERANK_API_STYLE=cohere
RERANK_VERIFY_SSL=true
RETRIEVAL_PLANNER_TIMEOUT_SECONDS=4

# ---- OCR for scanned PDFs ---------------------------------------------------------------------------
# Tesseract (Thai + English) is inside the api image and needs nothing. Softnix OCR and Mistral are optional.
# /ready probes Softnix OCR only when SOFTNIX_OCR_BASE_URL and SOFTNIX_OCR_TOKEN are both set. Leave both empty
# until you have them: with example values the probe fails and /ready reports ocr_chain "degraded" (or 503
# when no fallback engine is left in OCR_CHAIN_ENGINES).
SOFTNIX_OCR_BASE_URL=
SOFTNIX_OCR_TOKEN=
SOFTNIX_OCR_INSECURE_TLS=false
SOFTNIX_OCR_TIMEOUT_SECONDS=120
SOFTNIX_OCR_STALL_SECONDS=45
MISTRAL_API_KEY=
# Order of engines tried. With Softnix OCR: softnix,mistral,tesseract
OCR_CHAIN_ENGINES=tesseract
# Legacy external OCR v3 (only if you still use it).
EXT_OCR_BASE_URL=
EXT_OCR_KEY=
EXT_OCR_VERIFY_SSL=true

# ---- Retrieval and retention ------------------------------------------------------------------------
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=120
DEFAULT_TOP_K=12
MAX_GRAPH_DEPTH=3
LOG_QUERY_TEXT=false
OBSERVABILITY_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=180
