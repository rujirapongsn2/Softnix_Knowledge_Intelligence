server {
  listen 80;
  root /usr/share/nginx/html;
  client_max_body_size ${MAX_FILE_SIZE_MB}m;

  # Docker can assign a new address when the API container is recreated.
  # Resolve the service name at request time so the web container does not
  # keep proxying to the old address until nginx is restarted.
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $api_upstream api:8000;

  location / {
    # Always revalidate the app shell so a new deployment is visible without
    # requiring users to clear browser or CDN caches manually.
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    try_files $uri /index.html;
  }

  location = /index.html {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
  }

  location /assets/ {
    # Vite emits content-hashed filenames, so these files are safe to cache.
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  location /api/ {
    proxy_pass http://$api_upstream;
  }

  location /mcp {
    proxy_pass http://$api_upstream;
    proxy_http_version 1.1;
    proxy_read_timeout 300s;
  }
}
